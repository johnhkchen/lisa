# Maintainer: John Chen <john at johnhkchen dot com>

pkgname=lisa-bin
_pkgname=${pkgname%-bin}
pkgver=0.1.6
pkgrel=1
pkgdesc='DAG-driven concurrent task scheduling CLI for the RDSPI workflow'
arch=('x86_64' 'aarch64')
url='https://github.com/johnhkchen/lisa'
license=('MIT')
depends=('zellij')
provides=("$_pkgname")
conflicts=("$_pkgname")

source_x86_64=("${_pkgname}-${pkgver}-x86_64.tar.xz::${url}/releases/download/v${pkgver}/lisa-cli-x86_64-unknown-linux-musl.tar.xz")
source_aarch64=("${_pkgname}-${pkgver}-aarch64.tar.xz::${url}/releases/download/v${pkgver}/lisa-cli-aarch64-unknown-linux-musl.tar.xz")

# TODO: Replace with real checksums after first release (T-014-03)
# Generate with: updpkgsums (from pacman-contrib)
# Or manually: curl -L <url> | sha256sum
sha256sums_x86_64=('SKIP')
sha256sums_aarch64=('SKIP')

package() {
    install -Dm755 "${_pkgname}" "$pkgdir/usr/bin/${_pkgname}"

    # LICENSE is included in cargo-dist tarballs
    if [[ -f LICENSE ]]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    fi
}
